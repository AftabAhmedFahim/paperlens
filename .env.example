# ==============================================================================
# PaperLens Environment Configuration (Template)
# Copy this file to .env or .env.local and fill in the values.
# ==============================================================================

# ── Google Gemini AI ─────────────────────────────────────────────────────────
# Required for live AI question auditing and fix generation.
# Get an API key from: https://aistudio.google.com/app/apikey
# If left empty, PaperLens will use deterministic scoring and fallback questions.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for live analysis and fix-it suggestions.
# Default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# ── Demo Mode ────────────────────────────────────────────────────────────────
# 1 = Use deterministic demo responses (offline safe, verified 65 -> 82 flow)
# 0 = Use live Gemini AI API calls (requires GEMINI_API_KEY)
NEXT_PUBLIC_DEMO_MODE=1

# ── Faculty Authentication ───────────────────────────────────────────────────
# Secret key used by `jose` to sign and verify faculty JWT session cookies (HS256).
# For production, replace with a secure random 32+ character string.
AUTH_SECRET=paperlens_super_secret_jwt_key_2026_aust_carnival
